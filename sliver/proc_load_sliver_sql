/*
================================================================================
Stored Procedure : load sliver layer (bronze -> sliver )
================================================================================
script purpose:
     This stored procedure perform the ETL (extarct transform load ) process 
     to populate the 'sliver' schema tables the 'bronze' schema action 
     performed.

--Truncate sliver tables.
--Insert's transformed and clean data from bronze into sliver tables

Parameter's:
     This stored procedure does not accept any parameters or return any values.

Usage example:
     EXEC Databases;
==================================================================================


GO

create or alter procedure   Databases  as
begin
declare @start_time datetime , @end_time datetime;
 begin try
 set @start_time =  getdate();
 print'===========================';
print'Loading Databases';
print'===========================';

print'---------------------------';
print'Loading SLIVER CRM Table';
print'---------------------------';

print '>>>TRUNCATING TABLE : SLIVER<<<'
       truncate table sliver;
print'>>>INSERTING THE DATA INTO SLIVER<<<'
INSERT INTO sliver(
          cst_id,
          cst_key,
          cst_firstname,
          cst_lastname,
          cst_material_status,
          cst_gndr,
          cst_create_date)
select
cst_id,
cst_key,
trim (cst_firstname) as cst_firstname,
trim (cst_lastname) as cst_lastname,
    case when upper(trim(cst_material_status)) = 's' then 'Single'
         when upper(trim(cst_material_status)) = 'M' then 'Marriage'
         else 'LIVING RELATIONSHIP'
    end cst_material_status,

    case when UPPER(TRIM(cst_gndr)) = 'F' then 'Female'
         when UPPER(TRIM(cst_gndr)) = 'M' then 'Male'
         else 'unknown'
end cst_gndr,
cst_create_date
from(
select *,
row_number() over (partition by cst_id order by cst_create_date desc) as flag_last
from bronze
)t
where flag_last =1


print '>>>TRUNCATING TABLE : SLIVER1<<<'
truncate table sliver1;
print'>>>INSERTING THE DATA INTO SLIVER1<<<'
INSERT INTO sliver1 (
        prd_id,
        cat_id,
        prd_key,
        prd_nm,
        prd_cost,
        prd_line,
        prd_start_dt,
        prd_end_dt)
select 
prd_id,
REPLACE(SUBSTRING(prd_key, 1,5),'-','_')as cat_id,
SUBSTRING(prd_key, 7,len(prd_key))as prd_key,
prd_nm,
ISNULL(prd_cost, 0) as prd_cost,
CASE WHEN(TRIM(prd_line)) = 'M' THEN 'MOUNTAIN'
     WHEN(TRIM(prd_line)) = 'R' THEN 'ROAD'
     WHEN(TRIM(prd_line)) = 'S' THEN 'OTHER SALES'
     ELSE 'OUT OF STATE'
END prd_line,
CAST(prd_start_dt AS DATE) AS prd_start_dt,
CAST(LEAD(prd_start_dt) over (PARTITION BY prd_key ORDER BY prd_start_dt)-1 AS DATE) AS prd_end_dt
from broze1


print '>>>TRUNCATING TABLE : SLIVER2<<<'
       truncate table sliver2;
print'>>>INSERTING THE DATA INTO SLIVER2<<<'
INSERT INTO sliver2( sls_ord_num,
      sls_prd_key,
      sls_cust_id,
      sls_order,
      sls_ship_dt,
      sls_due_dt,
      sls_sales,
      sls_quantity ,
      sls_prince )
select 
sls_ord_num,
sls_prd_key,
sls_cust_id,
case when sls_order = 0 or len(sls_order) ! =8 then null
     else cast(cast(sls_order as varchar) as date)
end as sls_order_update,
case when sls_ship_dt = 0 or len(sls_ship_dt) ! =8 then null
     else cast(cast(sls_ship_dt as varchar) as date)
end as sls_ship_dt_update,
case when sls_due_dt = 0 or len(sls_due_dt) ! =8 then null
     else cast(cast(sls_due_dt as varchar) as date)
end as sls_due_dt_update,
case when sls_sales <=0 or sls_sales is null or  sls_sales != sls_quantity * ABS(sls_prince)
     then  sls_quantity * ABS(sls_prince)
     else sls_sales
end as sls_sales,
sls_quantity,
case when sls_prince is null or sls_prince <=0 
     then sls_sales / sls_quantity
     else sls_prince
end as sls_prince 
from broze2

print'---------------------------';
print'Loading  SLIVER ERP Table';
print'---------------------------';
print '>>>TRUNCATING TABLE : SLIVER3<<<'
       truncate table sliver3;
print'>>>INSERTING THE DATA INTO SLIVER<<<'
insert into sliver3(cid,cntry)
 select  
        replace(cid, '-','') cid,
    case when trim(cntry) = 'DE' then 'Jpan'
         when trim(cntry) IN ('US','USA') then 'united states '
         when trim(cntry) = '' or cntry is null then 'India'
         else cntry
end cntry
        from broze3 



print '>>>TRUNCATING TABLE : SLIVER4<<<'
      truncate table sliver4;
print'>>>INSERTING THE DATA INTO SLIVER4<<<'
INSERT INTO sliver4(cid,bdate,gen)
select 
case when cid like 'NAS%' then substring(cid, 4, len(cid))
     else cid
end cid,
case when bdate > getdate() then null
     else bdate
end as bdate,
case when UPPER(TRIM(gen)) in ('F' , 'Female') then 'Female'
     when UPPER(TRIM(gen)) in ('M' , 'Male') then 'Male'
      ELSE 'LESBIAN'
end as gen
 from broze4



print '>>>TRUNCATING TABLE : SLIVER5<<<'
 truncate table sliver5;
print'>>>INSERTING THE DATA INTO SLIVER5<<<'
insert into sliver5(
                    id,
                    cat,
                    subcat,
                    mintaenance)
select 
       id,
       cat,
       subcat,
       mintaenance
from broze5

SET @end_time = GETDATE();
PRINT'=====================';
PRINT'LOADING DATABASE LAYER IS COMPLETED :';
PRINT'- TOTAL LOAD DURATION : ' + CAST(DATEDIFF(second,@start_time,@end_time) AS NVARCHAR) + 'second';
print'=====================';
END TRY 
BEGIN CATCH
     PRINT'ERROR OCCURED DURING LOADING DATABASES';
     PRINT 'ERROR MESSAGE ' + ERROR_MESSAGE();
END CATCH

end




