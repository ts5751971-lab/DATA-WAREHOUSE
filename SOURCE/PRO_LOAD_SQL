     firstrow=2,
     fieldterminator=',',
     tablock
);

print'>> TRUNCATING TABLE: broze5';
TRUNCATE TABLE broze5;
print'INSERTING DATA INTO:broze5';
BULK INSERT broze5
from 'C:\Users\ASUS\Downloads\sql-data-warehouse-project\datasets\source_erp\PX_CAT_G1V2.csv'
