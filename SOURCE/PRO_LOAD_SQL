     firstrow=2,
     fieldterminator=',',
     tablock
);
SET @batch_end_time = GETDATE();
PRINT'=====================';
PRINT'LOADING DATABASE LAYER IS COMPLETED :';
PRINT'- TOTAL LOAD DURATION : ' + CAST(DATEDIFF(second,@start_batch,@batch_end_time) AS NVARCHAR) + 'second';
print'=====================';
END TRY 
BEGIN CATCH
     PRINT'ERROR OCCURED DURING LOADING DATABASES';
     PRINT 'ERROR MESSAGE ' + ERROR_MESSAGE();
END CATCH
end 
